          },
          "docs": "Request a transformation operation"
        },
        {
          "info": {
            "name": "Request a generation operation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gonitro.dev/generations"
          },
          "docs": "Request a generation operation"
        },
        {
          "info": {
            "name": "Request an extraction operation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gonitro.dev/extractions"
          },
          "docs": "Request an extraction operation"
